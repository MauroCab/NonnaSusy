@page "/ListaTotalProductosPedidos"
@rendermode InteractiveAuto
@using NonnaSusy.Services.HttpServices
@using NonnaSusy.Shared.DTO

@inject IHttpServicio http

<section class="page-productos-totales">
    <div class="page-content">
      <main class="main-content">
        <div class="content-layout">
          <section class="page-heading">
            <div class="heading-copy">
              <h1>Productos Pedidos Totales</h1>
              <p>
                Listado general consolidado de unidades pedidas por cada
                producto.
              </p>
            </div>
          </section>

          <section class="orders-card" aria-label="Listado de productos pedidos">
            <div class="table-toolbar">
                <div class="product-count"> 
                    <span>Total de productos pedidas:</span><span class="product-count-value">6</span>
                </div>
                <div class="date-filter">
                    <label for="fecha-pedidos">Fecha:</label>
                    <input type="date"
                            id="fecha-pedidos"
                            @bind="FechaSeleccionada"/>
                    <button class="save-button" type="button" @onclick="CargarProductosPedidos">
                        <span>Consultar fecha</span>
                    </button>
                </div>
            </div>
            <div class="table-scroll">
              <table class="orders-table">
                <thead>
                  <tr>
                    <th class="product-column">Producto</th>
                    <th>Unidades Totales Pedidas</th>
                  </tr>
                </thead>
                <tbody>
                    @foreach (var producto in ProductosPedidos)
                    {
                        <tr>
                            <td>
                                <div class="product-name">
                                    @producto.ProductoNombre
                                </div>
                            </td>

                            <td class="quantity-cell">
                                <span class="total-quantity">
                                    @producto.CantidadTotal
                                </span>
                                <span class="unit-label">uds</span>
                            </td>
                        </tr>
                    }
                </tbody>
              </table>
            </div>
          </section>
        </div>
      </main>
    </div>
  </section>

@code {
    private List<ProductoPedidoDTO> ProductosPedidos = new();

    private DateTime FechaSeleccionada = DateTime.Today + TimeSpan.FromDays(1);
    private async Task CargarProductosPedidos()
    {
        
        var respuesta = await http.GetTotalProductosPedidos<List<ProductoPedidoDTO>>(FechaSeleccionada);

        if (!respuesta.Error)
        {
            ProductosPedidos = respuesta.Respuesta ?? new();
        }
    }
}
