@page "/AgregarPedidos"
@rendermode InteractiveAuto

@using System.Net.Http.Json
@using NonnaSusy.DB.Data.Entities
@using NonnaSusy.Services.HttpServices
@using NonnaSusy.Shared.DTO

@inject IHttpServicio http

<section class="page-nuevo-pedido">
    <div class="page-content">
        <main class="main-content">
            <div class="content-layout">
                <div class="page-heading">
                    <div>
                        <h1>Nuevo Pedido</h1>
                        <p>Complete los detalles para registrar un nuevo pedido en el sistema.</p>
                    </div>
                </div>

                <div class="order-grid">
                    <div class="main-column">
                        <!-- Información del cliente -->
                        <section class="content-card">
                            <div class="section-heading">
                                <div class="section-icon customer-icon">
                                    <span class="material-symbols-outlined">person_search</span>
                                </div>
                                <h2>Seleccionar Cliente</h2>
                            </div>

                            

                            <select id="customer-select" class="customer-select" @bind="ClienteSeleccionadoID">
                                <option value="0">Busque o seleccione un cliente...</option>

                                @foreach (var cliente in Clientes)
                                {
                                    <option value="@cliente.ID">@cliente.NombreCliente</option>
                                }
                            </select>

                            <span class="material-symbols-outlined select-icon">arrow_drop_down</span>
                            
                            <div class="divider"></div>

                            <div class="products-section">
                                <div class="section-heading products-heading">
                                    <div class="section-icon products-icon">
                                        <span class="material-symbols-outlined">inventory_2</span>
                                    </div>
                                    <h2>Líneas de Pedido</h2>
                                </div>

                                <div class="product-lines" id="product-lines-container">
                                    <!-- Miniformulario fijo para agregar productos -->
                                    <div class="product-line">
                                        <div class="product-field">
                                            <label class="field-label">Producto</label>

                                            <div class="select-wrapper">
                                                <select class="product-select" @bind="ProductoSeleccionadoID">
                                                    <option value="0">Seleccionar producto</option>

                                                    @foreach (var producto in Productos)
                                                    {
                                                        <option value="@producto.ID">@producto.NombreProducto</option>
                                                    }
                                                </select>

                                                <span class="material-symbols-outlined select-icon product-select-icon">
                                                    expand_more
                                                </span>
                                            </div>
                                        </div>

                                        <div class="quantity-field">
                                            <label class="field-label">Cantidad</label>

                                            <input type="number"
                                                   min="1"
                                                   @bind="CantidadSeleccionada"
                                                   aria-label="Cantidad" />
                                        </div>
                                    </div>

                                    <!-- Lista de productos agregados -->
                                    <div id="product-lines-container">

                                        @foreach (var renglon in RenglonesTemporales)
                                        {
                                            var producto = Productos.FirstOrDefault(p => p.ID == renglon.ProductoID);

                                            <div class="product-line">
                                                <div class="product-field">
                                                    <label class="field-label">Producto</label>
                                                    <span>@producto?.NombreProducto</span>
                                                </div>

                                                <div class="quantity-field">
                                                    <label class="field-label">Cantidad</label>
                                                    <span>@renglon.Cantidad</span>
                                                </div>

                                                <div class="delete-area">
                                                    <button class="delete-button"
                                                            title="Eliminar línea"
                                                            type="button"
                                                            @onclick="() => EliminarProducto(renglon)">
                                                        <span class="material-symbols-outlined">delete</span>
                                                    </button>
                                                </div>
                                            </div>
                                        }

                                    </div>
                                </div>

                                <div class="add-product-area">
                                    <button class="add-product-button"
                                            id="add-product-btn"
                                            type="button"
                                            @onclick="AgregarProducto">

                                        <span class="material-symbols-outlined add-icon">add</span>
                                        <span>Añadir otra línea</span>
                                    </button>
                                </div>

                                
                            </div>
                        </section>
                    </div>

                    <!-- Resumen -->
                    <aside class="summary-column">
                        <section class="summary-card">
                            <h2>Resumen</h2>

                            @* <div class="summary-details">

                                    <div class="summary-row">
                                        <span>Subtotal estimado</span>
                                        <strong>--</strong>
                                    </div>
                                    <div class="summary-row">
                                        <span>Impuestos (Calculados post-guardado)</span>
                                        <span>--</span>
                                    </div>

                                    <div class="divider"></div>

                                
                                </div> *@

                            <button class="save-button" type="button">
                                <span class="material-symbols-outlined">save</span>
                                <span>Guardar Pedido</span>
                            </button>

                        </section>
                    </aside>
                </div>
            </div>
        </main>
    </div>
</section>

@code {
      
    private List<Cliente> Clientes = new();
    private List<Producto> Productos = new();

    private int ClienteSeleccionadoID;
    private int ProductoSeleccionadoID;

    private int CantidadSeleccionada = 1;
    private List<CrearRenglonDTO> RenglonesTemporales = new();

    protected override async Task OnInitializedAsync()
    {
        await base.OnInitializedAsync();
        await LeerDatos();
    }
    private async Task LeerDatos()
    {
        var clientes = await http.Get<List<Cliente>>("api/Clientes/ListaClientes");

        var productos = await http.Get<List<Producto>>("api/Productos/ListaProductos");

        Clientes = clientes.Respuesta.Select(c => new Cliente
        {
            ID = c.ID,
            NombreCliente = c.NombreCliente
        }).ToList();

        Productos = productos.Respuesta.Select(p => new Producto
        {
            ID = p.ID,
            NombreProducto = p.NombreProducto

        }).ToList();
    }

    private void AgregarProducto()
    {
        if (ProductoSeleccionadoID == 0 || CantidadSeleccionada < 1)
            return;

        RenglonesTemporales.Add(new CrearRenglonDTO
        {
            ProductoID = ProductoSeleccionadoID,
            Cantidad = CantidadSeleccionada
        });

        // Reiniciar el miniformulario
        ProductoSeleccionadoID = 0;
        CantidadSeleccionada = 1;
    }

    private void EliminarProducto(CrearRenglonDTO renglon)
    {
        RenglonesTemporales.Remove(renglon);
    }

        
}